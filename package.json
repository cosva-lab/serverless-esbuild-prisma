{
  "name": "@cosva-lab/serverless-esbuild-prisma",
  "version": "1.5.3",
  "description": "A Serverless Framework plugin that integrates ESBuild and Prisma for efficient bundling and seamless database management in serverless applications.",
  "main": "lib/index.js",
  "files": [
    "lib/**/*"
  ],
  "type": "commonjs",
  "scripts": {
    "build": "rimraf lib && tsc",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "lint:check": "eslint src/**/*.ts --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublish": "npm run build && npm run lint:check"
  },
  "author": "Eduard Castellanos <eduard@castellanos.dev>",
  "license": "ISC",
  "repository": {
    "url": "https://github.com/cosva-lab/serverless-esbuild-prisma.git",
    "type": "git"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.540.0",
    "@aws-sdk/client-sts": "^3.540.0",
    "@prisma/internals": "^6.14.0",
    "@types/adm-zip": "^0.5.7",
    "@types/jest": "^29.5.8",
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "adm-zip": "^0.5.12",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "glob": "^10.3.15",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-lambda": "^3",
    "@aws-sdk/client-sts": "^3",
    "@prisma/internals": "^5 || ^6",
    "adm-zip": "^0.5",
    "glob": "*"
  }
}